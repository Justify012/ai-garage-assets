    "icons": "https://cdn.jsdelivr.net/gh/justify012/ai-garage-assets@main/icons/",
    "characters": "https://cdn.jsdelivr.net/gh/justify012/ai-garage-assets@main/characters/"
  },
  "formats": {
    "hosted": "svg",
    "icon_file": "<name>.svg",
    "character_file": "<pose>.svg",
    "png_icon_file": "<name>.png",
    "png_character_file": "<pose>.png",
    "note": "The hosted library is vector (SVG). It is sharper than PNG at thumbnail scale and the whole library is ~45 KB. PNG copies are materialised by .github/workflows/deploy-assets.yml once the connected GitHub App has the workflows permission; until then the .png URL is absent and SVG is the only format to fetch."
  },
  "character_lock": {
    "canvas": 512,
    "figure_height_px": 460,
    "ground_line_y": 500,
    "body_center_x": 256,
    "head_width_px": 72,
    "default_on_screen_height_px": 380,
    "default_scale": 0.826,
    "palette": {
      "shirt": "#5C88B4",
      "trousers": "#8B6B4A",
      "hair": "#E08A3C",
      "shoes": "#4A3524",
      "skin": "#F3D3B4"
    },
    "treatment": {
      "cut_border": 0,
      "fibre_overlay": false,
      "rotation": "\u00b12\u00b0 only, seeded by pose name",
      "shadow": {
        "offset_x": 6,
        "offset_y": 8,
        "blur": 12,
        "opacity": 0.28
      },
      "note": "This character is a rendered illustration, not a cut-paper shape. Keep the drop shadow so he sits on the kraft table, but skip the cut border and the fibre overlay \u2014 they mottle a textured figure."
    },
    "rules": [
      "fetch_never_redraw",
      "one_pose_per_scene",
      "max_one_scene_in_four",
      "never_advising",
      "same_transform_in_every_pose"
    ]
  },
  "notes": "Fetch PNG for rendering, SVG for editing. 512x512 RGBA transparent PNG; alpha=0 at corners, alpha=255 at centre. Filenames carry no extension in the *_png lists."
}